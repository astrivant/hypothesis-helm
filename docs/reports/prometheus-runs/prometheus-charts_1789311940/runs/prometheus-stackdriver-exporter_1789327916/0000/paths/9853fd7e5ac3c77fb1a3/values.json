{
  "nameOverride": "",
  "fullnameOverride": "",
  "namespaceOverride": "",
  "replicaCount": 1,
  "restartPolicy": "Always",
  "image": {
    "repository": "prometheuscommunity/stackdriver-exporter",
    "tag": "",
    "pullPolicy": "IfNotPresent"
  },
  "resources": {},
  "securityContext": {},
  "containerSecurityContext": {},
  "livenessProbe": {
    "httpGet": {
      "path": "/",
      "port": "http",
      "scheme": "HTTP"
    },
    "initialDelaySeconds": 30,
    "timeoutSeconds": 10
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/",
      "port": "http",
      "scheme": "HTTP"
    },
    "initialDelaySeconds": 10,
    "timeoutSeconds": 10
  },
  "service": {
    "type": "ClusterIP",
    "httpPort": 9255,
    "annotations": {}
  },
  "customLabels": {},
  "secret": {
    "labels": {}
  },
  "stackdriver": {
    "projectIds": [],
    "projectFilters": "\n",
    "serviceAccountSecret": "",
    "serviceAccountSecretKey": "",
    "serviceAccountKey": "",
    "maxRetries": 0,
    "universeDomain": "",
    "httpTimeout": "10s",
    "maxBackoff": "5s",
    "backoffJitter": "1s",
    "retryStatuses": 503,
    "dropDelegatedProjects": false,
    "metrics": {
      "prefixes": [
        "compute.googleapis.com/instance/cpu"
      ],
      "filters": [],
