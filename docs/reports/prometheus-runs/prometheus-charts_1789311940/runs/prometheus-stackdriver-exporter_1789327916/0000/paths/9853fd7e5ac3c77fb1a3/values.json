    "create": false,
    "name": null,
    "annotations": {}
  },
  "serviceMonitor": {
    "enabled": false,
    "namespace": "monitoring",
    "scrapeClass": null,
    "additionalLabels": {},
    "scrapeTimeout": "10s",
    "interval": "10s",
    "honorLabels": true,
    "honorTimestamps": true,
    "metricRelabelings": [],
    "relabelings": []
  },
  "prometheusRule": {
    "enabled": false,
    "additionalLabels": {},
    "namespace": "",
    "rules": []
