{
  "replicaCount": 1,
  "image": {
    "repository": "natsio/prometheus-nats-exporter",
    "tag": "\"",
    "pullPolicy": "IfNotPresent",
    "imagePullSecrets": []
  },
  "service": {
    "labels": {},
    "annotations": {},
    "type": "ClusterIP",
    "port": 80,
    "targetPort": 7777
  },
  "livenessProbe": {
    "timeoutSeconds": 1,
    "periodSeconds": 10
  },
  "readinessProbe": {
    "timeoutSeconds": 1,
    "periodSeconds": 10
  },
  "serviceMonitor": {
    "enabled": false,
    "additionalLabels": {},
    "namespace": null,
    "interval": null,
    "scrapeTimeout": null,
    "targetLabels": []
  },
  "resources": {},
  "config": {
    "nats": {
      "service": "nats-nats-monitoring",
      "namespace": "default",
      "port": 8222
    },
    "metrics": {
      "accstatz": true,
      "connz": true,
      "connz_detailed": true,
      "jsz": true,
      "gatewayz": true,
      "healthz": true,
      "leafz": true,
      "routez": true,
      "subz": true,
      "varz": true
    }
  },
  "nodeSelector": {},
  "tolerations": [],
  "affinity": {},
  "annotations": {},
  "extraContainers": "",
  "extraVolumes": ""
}
