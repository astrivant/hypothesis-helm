{
  "global": {
    "imagePullSecrets": []
  },
  "nameOverride": "",
  "namespaceOverride": "",
  "fullnameOverride": "",
  "image": {
    "pullPolicy": "IfNotPresent",
    "repository": "quay.io/jiralert/jiralert-linux-amd64",
    "tag": ""
  },
  "extraArgs": [
    "-log.level=debug"
  ],
  "strategy": {},
  "extraVolumeMounts": [],
  "extraVolumes": [],
  "env": {},
  "envFrom": {},
  "replicaCount": 1,
  "resources": {
    "limits": {
      "cpu": "200m",
      "memory": "128Mi"
    },
    "requests": {
      "cpu": "100m",
      "memory": "64Mi"
    }
  },
  "annotations": {},
  "podAnnotations": {},
  "podSecurityContext": {
    "seccompProfile": {
      "type": "RuntimeDefault"
    }
  },
  "podDisruptionBudget": {},
  "topologySpreadConstraints": [],
  "securityContext": {
    "runAsUser": 1001,
    "runAsGroup": 1001,
    "runAsNonRoot": true,
    "allowPrivilegeEscalation": false,
    "readOnlyRootFilesystem": true,
    "capabilities": {
      "drop": [
        "ALL"
      ]
    }
  },
  "livenessProbe": {
    "httpGet": {
      "path": "/healthz",
      "port": "http"
    }
  },
  "readinessProbe": {
    "httpGet": {
      "path": "/healthz",
      "port": "http"
    }
  },
  "serviceAccount": {
    "create": true,
    "name": "",
    "annotations": {
      "": []
    },
    "labels": {},
    "automountServiceAccountToken": false
  },
  "existingConfigSecret": null,
  "tplConfig": false,
  "config": {
    "template": "jiralert.tmpl",
    "defaults": {
      "api_url": "https://example.atlassian.net",
      "summary": "{{ template \"jira.summary\" . }}",
      "description": "{{ template \"jira.description\" . }}",
      "issue_type": "Bug",
      "reopen_state": "To Do",
      "reopen_duration": "0h"
    },
    "receivers": []
  },
  "configString": "",
  "affinity": {},
  "nodeSelector": {},
  "tolerations": [],
  "priorityClassName": "",
  "ingress": {
    "enabled": false,
    "className": "",
    "labels": {},
    "annotations": {},
    "hosts": [
      {
        "host": "chart-example.local",
        "paths": [
          {
            "path": "/",
            "pathType": "ImplementationSpecific"
          }
        ]
      }
    ],
    "tls": []
  },
  "issueTemplate": "{{`{{ define \"jira.summary\" }}[{{ .Status | toUpper }}{{ if eq .Status \"firing\" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .GroupLabels.SortedPairs.Values | join \" \" }} {{ if gt (len .CommonLabels) (len .GroupLabels) }}({{ with .CommonLabels.Remove .GroupLabels.Names }}{{ .Values | join \" \" }}{{ end }}){{ end }}{{ end }}\n\n{{ define \"jira.description\" }}{{ range .Alerts.Firing }}Labels:\n{{ range .Labels.SortedPairs }} - {{ .Name }} = {{ .Value }}\n{{ end }}\nAnnotations:\n{{ range .Annotations.SortedPairs }} - {{ .Name }} = {{ .Value }}\n{{ end }}\nSource: {{ .GeneratorURL }}\n{{ end }}{{ end }}`}}\n",
  "serviceMonitor": {
    "enabled": false,
    "additionalLabels": {},
    "honorLabels": true,
    "metricRelabelings": [],
    "relabelings": []
  },
  "route": {
    "main": {
      "enabled": false,
      "apiVersion": "",
      "kind": "",
      "name": "",
      "annotations": {},
      "labels": {},
      "parentRefs": [],
      "hostnames": [],
      "additionalRules": [],
      "filters": [],
      "matches": [
        {
          "path": {
            "type": "PathPrefix",
            "value": "/"
          }
        }
      ],
      "httpsRedirect": false
    }
  }
}
