{
  "replicaCount": 1,
  "image": {
    "repository": "prom/statsd-exporter",
    "pullPolicy": "IfNotPresent",
    "tag": ""
  },
  "imagePullSecrets": [],
  "nameOverride": "",
  "fullnameOverride": "",
  "extraEnv": {},
  "extraArgs": [],
  "statsd": {
    "udpPort": 9125,
    "tcpPort": 9125,
    "cacheSize": 1000,
    "eventQueueSize": 10000,
    "eventFlushThreshold": 1000,
    "eventFlushInterval": "200ms"
