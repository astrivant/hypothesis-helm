    "initialDelaySeconds": 3,
    "timeoutSeconds": 3
  },
  "readinessProbe": {
    "initialDelaySeconds": 5,
    "timeoutSeconds": 10
  },
  "extraEnvs": [],
  "initContainers": [],
  "extraContainers": [],
  "extraVolumes": [],
  "extraVolumeMounts": [],
  "podDisruptionBudget": {
    "enabled": false,
    "maxUnavailable": 1
  }
