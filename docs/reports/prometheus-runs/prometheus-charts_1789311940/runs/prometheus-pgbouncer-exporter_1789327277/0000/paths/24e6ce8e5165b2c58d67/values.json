{
  "replicaCount": 1,
  "image": {
    "repository": "quay.io/prometheuscommunity/pgbouncer-exporter",
    "tag": "",
    "pullPolicy": "IfNotPresent"
  },
  "service": {
    "type": "ClusterIP",
    "port": 80,
    "targetPort": 9127,
    "name": "http",
    "labels": {},
    "annotations": {}
  },
  "serviceMonitor": {
    "enabled": false
  },
  "prometheusRule": {
    "enabled": false,
    "additionalLabels": {},
    "namespace": "",
    "rules": []
  },
  "resources": {},
