        "name": "topology.webhook.gateway.envoyproxy.io",
        "admissionReviewVersions": [
          "v1"
        ],
        "sideEffects": "None",
        "clientConfig": {
          "service": {
            "name": "hypothesis-envoy-gateway",
            "namespace": "default",
            "path": "/inject-pod-topology",
            "port": 9443
          }
        },
        "failurePolicy": "Ignore",
        "rules": [
          {
            "operations": [
              "CREATE"
            ],
            "apiGroups": [
              ""
            ],
            "apiVersions": [
              "v1"
            ],
            "resources": [
              "pods/binding"
            ]
          }
        ],
        "namespaceSelector": {
          "matchExpressions": [
            {
              "key": "kubernetes.io/metadata.name",
              "operator": "In",
              "values": [
                "default"
              ]
            }
          ]
        }
      }
    ]
