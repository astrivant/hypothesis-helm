  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "hypothesis-envoy-gateway",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/instance": "hypothesis",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "envoy-gateway",
        "app.kubernetes.io/version": "1.5.0",
        "helm.sh/chart": "envoy-gateway-2.0.5",
        "app.kubernetes.io/part-of": "envoy-gateway",
        "app.kubernetes.io/component": "envoy-gateway"
      }
    },
    "spec": {
      "type": "ClusterIP",
      "sessionAffinity": "None",
      "ports": [
        {
          "name": "grpc",
          "port": 18000,
          "protocol": "TCP",
          "nodePort": null,
          "targetPort": "grpc"
        },
        {
          "name": "tcp-ratelimit",
          "port": 18001,
          "protocol": "TCP",
          "nodePort": null,
          "targetPort": "tcp-ratelimit"
        },
        {
          "name": "tcp-wasm",
          "port": 18002,
          "protocol": "TCP",
          "nodePort": null,
          "targetPort": "tcp-wasm"
        },
        {
          "name": "http-webhook",
          "port": 9443,
          "protocol": "TCP",
          "nodePort": null,
          "targetPort": "http-webhook"
        }
      ],
      "selector": {
        "app.kubernetes.io/instance": "hypothesis",
        "app.kubernetes.io/name": "envoy-gateway",
        "app.kubernetes.io/part-of": "envoy-gateway",
        "app.kubernetes.io/component": "envoy-gateway"
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "hypothesis-envoy-gateway",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/instance": "hypothesis",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "envoy-gateway",
        "app.kubernetes.io/version": "1.5.0",
        "helm.sh/chart": "envoy-gateway-2.0.5",
        "app.kubernetes.io/part-of": "envoy-gateway",
        "app.kubernetes.io/component": "envoy-gateway"
      }
    },
    "spec": {
      "replicas": 1,
      "strategy": {
        "type": "RollingUpdate"
      },
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/instance": "hypothesis",
          "app.kubernetes.io/name": "envoy-gateway",
          "app.kubernetes.io/part-of": "envoy-gateway",
          "app.kubernetes.io/component": "envoy-gateway"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/instance": "hypothesis",
            "app.kubernetes.io/managed-by": "Helm",
            "app.kubernetes.io/name": "envoy-gateway",
            "app.kubernetes.io/version": "1.5.0",
            "helm.sh/chart": "envoy-gateway-2.0.5",
            "app.kubernetes.io/part-of": "envoy-gateway",
            "app.kubernetes.io/component": "envoy-gateway"
          },
          "annotations": {
            "checksum/config": "66c68301fc6b8fcfcfeeab2f2a8cb81f4831d20abb3eb259687c8f5161350e55"
          }
        },
        "spec": {
          "serviceAccountName": "hypothesis-envoy-gateway-certgen",
          "automountServiceAccountToken": true,
          "affinity": {
            "podAffinity": null,
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": [
                {
                  "podAffinityTerm": {
                    "labelSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/instance": "hypothesis",
                        "app.kubernetes.io/name": "envoy-gateway",
                        "app.kubernetes.io/component": "operator"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  },
                  "weight": 1
                }
              ]
            },
            "nodeAffinity": null
          },
          "securityContext": {
            "fsGroup": 1001,
            "fsGroupChangePolicy": "Always",
            "supplementalGroups": [],
            "sysctls": []
          },
          "containers": [
            {
              "name": "envoy-gateway",
              "image": "docker.io/bitnami/envoy-gateway:1.5.0-debian-12-r1",
              "imagePullPolicy": "IfNotPresent",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "privileged": false,
                "readOnlyRootFilesystem": true,
                "runAsGroup": 1001,
                "runAsNonRoot": true,
                "runAsUser": 1001,
                "seLinuxOptions": {},
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "args": [
                "server",
                "--config-path=/config/envoy-gateway.yaml"
              ],
              "env": [
                {
                  "name": "ENVOY_GATEWAY_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "metadata.namespace"
                    }
                  }
                },
                {
                  "name": "DEFAULT_ENVOY_IMAGE",
                  "value": "docker.io/bitnami/envoy:1.35.1-debian-12-r0"
                },
                {
                  "name": "DEFAULT_SHUTDOWN_IMAGE",
                  "value": "docker.io/bitnami/envoy-gateway:1.5.0-debian-12-r1"
                },
                {
                  "name": "DEFAULT_RATELIMIT_IMAGE",
                  "value": "docker.io/bitnami/envoy-ratelimit:2025.8.15-debian-12-r0"
                },
                {
                  "name": "KUBERNETES_CLUSTER_DOMAIN",
                  "value": "cluster.local"
                }
              ],
              "envFrom": null,
              "resources": {
                "limits": {
                  "cpu": "150m",
                  "ephemeral-storage": "2Gi",
                  "memory": "192Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "ephemeral-storage": "50Mi",
                  "memory": "128Mi"
                }
              },
              "ports": [
                {
                  "name": "grpc",
                  "containerPort": 18000
                },
                {
                  "name": "tcp-ratelimit",
                  "containerPort": 18001
                },
                {
                  "name": "tcp-wasm",
                  "containerPort": 18002
                },
                {
                  "name": "http-admin",
                  "containerPort": 19000
                },
                {
                  "name": "http-metrics",
                  "containerPort": 19001
                },
                {
                  "name": "http-health",
                  "containerPort": 8081
                },
                {
                  "name": "http-webhook",
                  "containerPort": 9443
                }
              ],
              "livenessProbe": {
                "failureThreshold": 5,
                "initialDelaySeconds": 5,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 5,
                "httpGet": {
                  "path": "/healthz",
                  "port": "http-health"
                }
              },
              "readinessProbe": {
                "failureThreshold": 5,
                "initialDelaySeconds": 5,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 5,
                "httpGet": {
                  "path": "/readyz",
                  "port": "http-health"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/config",
                  "name": "configuration",
                  "readOnly": true
                },
                {
                  "mountPath": "/certs",
                  "name": "certs",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "configuration",
              "configMap": {
                "name": "hypothesis-envoy-gateway"
              }
            },
            {
              "name": "certs",
              "secret": {
                "defaultMode": 420,
                "optional": true,
                "secretName": "envoy-gateway"
              }
            }
          ]
        }
      }
    }
