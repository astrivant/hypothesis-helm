#!/usr/bin/env python3
"""
Provide deterministic synthetic GitHub responses for benchmark publication tests.

Set BENCHMARK_GH_DEBUG=1 to enable debug diagnostics on stderr.
"""

from __future__ import annotations

import logging
import os
import sys
from pathlib import Path


def main() -> int:
    """
    Return fixture PR metadata and accept synthetic status or workflow requests.

    Returns:
        int: Zero for supported fixture requests; two for an unexpected request.
    """
    level = logging.DEBUG if os.environ.get("BENCHMARK_GH_DEBUG") == "1" else logging.INFO
    logging.basicConfig(level=level, format="%(levelname)s: %(message)s")
    arguments = sys.argv[1:]
    logging.info("Handling a synthetic GitHub request")
    if arguments[:1] == ["api"] and any("/pulls/" in item for item in arguments):
        sys.stdout.write(Path(os.environ["BENCHMARK_GH_METADATA"]).read_text())
        return 0
    if arguments[:1] == ["api"] and any("/statuses/" in item for item in arguments):
        return 0
    if arguments[:2] == ["workflow", "run"]:
        return 0
    logging.error("Unsupported synthetic GitHub request")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
