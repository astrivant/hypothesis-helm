# Python's CSV writer emits standard CRLF record separators.
studies/**/*.csv whitespace=cr-at-eol
docs/reports/**/*.csv whitespace=cr-at-eol
*.pdf binary
# Matplotlib vector exports are generated artifacts.
studies/**/*.svg binary
docs/reports/**/*.svg binary
# Raw measurements and retained scan evidence; rendered reports stay browsable in Git.
studies/**/*.log filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.csv filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.tsv filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.gz filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.err filter=lfs diff=lfs merge=lfs -text
studies/**/*.json filter=lfs diff=lfs merge=lfs -text
studies/**/*.tsv filter=lfs diff=lfs merge=lfs -text
studies/**/*.err filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.json filter=lfs diff=lfs merge=lfs -text
docs/reports/**/*.log filter=lfs diff=lfs merge=lfs -text
studies/**/*.csv filter=lfs diff=lfs merge=lfs -text
studies/**/*.gz filter=lfs diff=lfs merge=lfs -text
# Chart schemas are fixture source, including those beside benchmark results.
studies/**/values.schema.json !filter !diff !merge text
# Small final report attachments must remain available without the paused raw-data LFS uploads.
docs/reports/*-data/*.audit.json.gz !filter !diff !merge binary
docs/reports/*/report-data/*.audit.json.gz !filter !diff !merge binary
